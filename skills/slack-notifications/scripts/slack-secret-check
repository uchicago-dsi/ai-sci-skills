#!/usr/bin/env bash
# The safety rules shared by every script that talks to Slack.
#
#   printf '%s' "$msg" | slack-secret-check          # 0 = safe to post, 3 = blocked
#   slack-secret-check --private FILE                # 0 = FILE is owner-only, 1 = not
#
# Message mode refuses anything that is, or looks like, a credential. It runs in
# code rather than relying on whoever composed the message, so a tricked caller
# (a person or an agent) still cannot leak a secret into the channel. The message
# arrives on stdin, not as an argument, because arguments show up in `ps` for
# every user on a shared node. Errors never echo the match, or the error itself
# would leak it into a log.
#
# Secret files checked by exact match: SLACK_WEBHOOK_FILE, SLACK_BOT_TOKEN_FILE,
# and any colon-separated paths in SLACK_EXTRA_SECRET_FILES.
set -uo pipefail

cfg=${SLACK_NOTIFY_CONFIG:-$HOME/.config/slack-notifications/config}
[[ -r $cfg ]] && source "$cfg"

if [[ ${1:-} == --private ]]; then
  f=${2:?usage: slack-secret-check --private FILE}
  [[ -r $f ]] || { echo "missing or unreadable: $f" >&2; exit 1; }
  # Any group/other permission bit means someone else on the machine can read it.
  if [[ -n $(find "$f" -maxdepth 0 -perm /077) ]]; then
    echo "refusing: $f is readable by other users; run: chmod 600 '$f'" >&2; exit 1
  fi
  exit 0
fi

msg=$(cat)

# 1. The actual secrets, exact match: catches them whatever format they take.
IFS=: read -r -a extra <<<"${SLACK_EXTRA_SECRET_FILES:-}"
for f in "${SLACK_WEBHOOK_FILE:-$HOME/.slack-webhook}" \
         "${SLACK_BOT_TOKEN_FILE:-$HOME/.slack-bot-token}" "${extra[@]}"; do
  if [[ -n $f && -s $f ]] && grep -qF -f "$f" <<<"$msg"; then
    echo "BLOCKED: message contains the secret stored in $f" >&2; exit 3
  fi
done

# 2. Anything shaped like a credential: Slack tokens and webhooks, private keys,
#    GitHub, Anthropic/OpenAI and AWS keys. Short fragments (e.g. "the first 10
#    characters") slip under these lengths; refusing those is the caller's job.
secret_re='xox[abpors]-[A-Za-z0-9-]{10,}|hooks\.slack\.com/services/|-----BEGIN [A-Z ]*PRIVATE KEY|gh[pousr]_[A-Za-z0-9]{30,}|sk-(ant-)?[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}'
if grep -qE -- "$secret_re" <<<"$msg"; then
  echo "BLOCKED: message contains something that looks like a credential" >&2; exit 3
fi
exit 0
